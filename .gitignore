# ---- never in the repo ----
# written by udiksa theme on every theme switch (setup/rice.sh runs udiksa theme, which recreates them)
dots/.config/hypr/conf/colors.lua
dots/.config/kitty/colors.conf
optional/zed/dots/.config/zed/themes/
dots/.config/kitty/clock.conf
dots/.config/quickshell/colors.json
dots/.config/gtk-3.0/gtk.css
dots/.config/gtk-4.0/gtk.css
dots/.config/gtk-3.0/settings.ini
dots/.config/gtk-4.0/settings.ini
dots/.config/fastfetch/config.jsonc
optional/ncspot/dots/.config/ncspot/config.toml
dots/.config/mpv/script-opts/

# PERSONAL LAYER: your own choices on this machine (Settings writes them); the repo ships only the design
dots/.config/hypr/local/
# generated from the Battery & sleep choices (udiksa settings power apply)
dots/.config/hypr/hypridle.conf

# app state, not configuration
optional/ncspot/dots/.config/ncspot/userstate.cbor
optional/ncspot/dots/.config/ncspot/credentials*
__pycache__/
*.tmp

# ---- development notes (local only: the project log + DIY guide, never committed) ----
dev/

# ---- graphify (local knowledge graph of the repo; rebuilt, never committed) ----
graphify-out/
.graphifyignore
# written by udiksa font / udiksa theme (Settings > Fonts); the choice itself is in ~/.local/state/rice/fonts.json
dots/.config/hypr/conf/fonts.lua
dots/.config/quickshell/fonts.json
dots/.config/kitty/fonts.conf
dots/.config/mpv/fonts.conf
dots/.config/fontconfig/conf.d/
# written by udiksa comfort (eye comfort shield)
dots/.config/hypr/hyprsunset.conf
