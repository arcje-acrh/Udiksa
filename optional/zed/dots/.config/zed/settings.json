// Zed settings. The "Rice" theme is written by udiksa theme on every theme change (~/.config/zed/themes/rice.json).
// Hyprland gives the window the same see-through + blur as every other app, so the theme itself stays solid.
{
  "agent_servers": {
    "claude-acp": {
      "default_config_options": {
        "effort": "medium"
      },
      "type": "registry"
    }
  },
  "theme": "Rice",
  "ui_font_family": "Space Grotesk",
  "buffer_font_family": "Iosevka Nerd Font",
  "buffer_font_size": 15,
  "ui_font_size": 15,
  "buffer_line_height": "comfortable",
  "cursor_blink": false,

  // quiet chrome: no sign-in, banners, minimap, scrollbars or collaboration buttons
  "title_bar": { "show_sign_in": false, "show_user_picture": false, "show_onboarding_banner": false },
  "minimap": { "show": "never" },
  "scrollbar": { "show": "never" },
  "toolbar": { "quick_actions": false },
  "tab_bar": { "show_nav_history_buttons": false },
  "collaboration_panel": { "button": false },
  "git": { "inline_blame": { "enabled": false } },

  // JetBrains / VS Code layout: files on the left, the AI agent on the right
  "project_panel": { "dock": "left", "default_width": 260 },
  "agent": { "dock": "right", "default_width": 660 },
  "git_panel": { "dock": "left" },
  "outline_panel": { "dock": "right" },

  "terminal": { "font_family": "Iosevka Nerd Font", "blinking": "off", "copy_on_select": true },

  "telemetry": { "diagnostics": false, "metrics": false },
  "auto_update": false,

  // Lua (Hyprland config) and QML (the shell) are not built into Zed; fetched once on first start
  "auto_install_extensions": { "lua": true, "qml": true }
}
