#!/usr/bin/env python3
"""udiksa comfort -- comfort lighting (eye comfort shield): warms the screen's colours to cut blue light, by hyprsunset.

  udiksa comfort                    state (JSON): mode, temperature, times, running
  udiksa comfort on | off | toggle  warm the screen now (mode "always") / back to normal
  udiksa comfort temp <K>           colour temperature, 2500 (very warm) .. 6000 (almost neutral); saved + applied live
  udiksa comfort mode <m>           off | always | schedule | sunset
  udiksa comfort schedule <from> <to>   e.g. 20:00 07:00 (mode "schedule")
  udiksa comfort preview <K>        show a temperature without saving it (the Settings slider uses it while you drag)
  udiksa comfort apply              write ~/.config/hypr/hyprsunset.conf and (re)start the daemon (login does it)

Modes: always = warm all day; schedule = warm between two times; sunset = warm from local sunset to sunrise (your weather
location from Settings > Date & language; 18:30 - 06:30 when none is set). The choice lives in ~/.local/state/rice/comfort.json."""
import datetime, json, math, os, shutil, subprocess, sys, time

HOME = os.path.expanduser("~")
STATE = os.path.join(HOME, ".local/state/rice/comfort.json")
CONF = os.path.join(HOME, ".config/hypr/hyprsunset.conf")
SHELL = os.path.join(HOME, ".local/state/quickshell/shell.json")
DEFAULTS = {"mode": "off", "temp": 4500, "from": "20:00", "to": "07:00"}


def load():
    d = dict(DEFAULTS)
    try:
        d.update({k: v for k, v in json.load(open(STATE)).items() if k in d})
    except (OSError, ValueError):
        pass
    return d


def save(d):
    os.makedirs(os.path.dirname(STATE), exist_ok=True)
    with open(STATE, "w") as f:
        json.dump(d, f, indent=2); f.write("\n")


def running():
    return subprocess.run(["pgrep", "-x", "hyprsunset"], capture_output=True).returncode == 0


def sun(lat, lon, day):
    """local sunrise / sunset as "HH:MM" (the almanac algorithm); None when the sun does not rise or set that day"""
    rad, deg = math.radians, math.degrees
    n = day.timetuple().tm_yday; lng = lon / 15; off = time.localtime().tm_gmtoff / 3600
    out = []
    for rising in (True, False):
        t = n + ((6 if rising else 18) - lng) / 24
        m = 0.9856 * t - 3.289
        l = (m + 1.916 * math.sin(rad(m)) + 0.020 * math.sin(rad(2 * m)) + 282.634) % 360
        ra = deg(math.atan(0.91764 * math.tan(rad(l)))) % 360
        ra += math.floor(l / 90) * 90 - math.floor(ra / 90) * 90
        sd = 0.39782 * math.sin(rad(l)); cd = math.cos(math.asin(sd))
        ch = (math.cos(rad(90.833)) - sd * math.sin(rad(lat))) / (cd * math.cos(rad(lat)))
        if abs(ch) > 1:
            return None
        h = (360 - deg(math.acos(ch)) if rising else deg(math.acos(ch))) / 15
        ut = (h + ra / 15 - 0.06571 * t - 6.622 - lng) % 24
        loc = (ut + off) % 24
        out.append("%02d:%02d" % (int(loc), int((loc % 1) * 60)))
    return tuple(out)


def times(d):
    """(from, to) the warm period for the saved mode"""
    if d["mode"] == "sunset":
        try:
            w = json.load(open(SHELL)).get("weather", {})
            r = sun(float(w["lat"]), float(w["lon"]), datetime.date.today())
            if r:
                return r[1], r[0]
        except (OSError, ValueError, KeyError, TypeError):
            pass
        return "18:30", "06:30"
    return d["from"], d["to"]


def write_conf(d):
    t = int(d["temp"])
    if d["mode"] == "always":
        body = f"profile {{\n    time = 00:00\n    temperature = {t}\n}}\n"
    else:
        a, b = times(d)
        body = f"profile {{\n    time = {b}\n    identity = true\n}}\n\nprofile {{\n    time = {a}\n    temperature = {t}\n}}\n"
    os.makedirs(os.path.dirname(CONF), exist_ok=True)
    with open(CONF, "w") as f:
        f.write("# hyprsunset -- WRITTEN BY udiksa comfort (Settings > Display > Comfort lighting); edits are overwritten\n" + body)


def stop():
    subprocess.run(["pkill", "-x", "hyprsunset"])


def start():
    if not shutil.which("hyprsunset"):
        sys.exit("hyprsunset is not installed (sudo pacman -S hyprsunset)")
    stop(); time.sleep(0.3)
    subprocess.Popen(["hyprsunset"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)


def apply():
    d = load()
    if d["mode"] == "off":
        stop()
        return
    write_conf(d)
    start()


def main(a):
    d = load()
    cmd = a[0] if a else ""
    if cmd == "":
        print(json.dumps({**d, "running": running(), "warm": list(times(d)) if d["mode"] in ("schedule", "sunset") else []}))
    elif cmd in ("on", "off", "toggle"):
        d["mode"] = {"on": "always", "off": "off", "toggle": "off" if d["mode"] != "off" else "always"}[cmd]
        save(d); apply()
    elif cmd == "temp" and len(a) > 1:
        d["temp"] = max(2500, min(6000, int(float(a[1])))); save(d)
        if d["mode"] == "off":      # the shield is off: only remember the number
            return
        write_conf(d)
        if d["mode"] == "always" and running():
            subprocess.run(["hyprctl", "hyprsunset", "temperature", str(d["temp"])], capture_output=True)   # live, no restart
        else:
            apply()                 # a schedule reads its profiles at start
    elif cmd == "mode" and len(a) > 1 and a[1] in ("off", "always", "schedule", "sunset"):
        d["mode"] = a[1]; save(d); apply()
    elif cmd == "schedule" and len(a) > 2:
        d["from"], d["to"] = a[1], a[2]; d["mode"] = "schedule"; save(d); apply()
    elif cmd == "preview" and len(a) > 1:
        if not running():
            start(); time.sleep(0.6)
        subprocess.run(["hyprctl", "hyprsunset", "temperature", str(max(2500, min(6500, int(float(a[1])))))], capture_output=True)
    elif cmd == "apply":
        apply()
    else:
        print(__doc__)


if __name__ == "__main__":
    main(sys.argv[1:])
