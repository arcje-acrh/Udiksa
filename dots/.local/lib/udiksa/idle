#!/usr/bin/env bash
# udiksa idle -- the timed actions of hypridle (~/.config/hypr/hypridle.conf, written by Settings > Power), and
# "sleep" for the notch power menu.
#   udiksa idle off   <bat|ac|any>    screen off, only when on that power source
#   udiksa idle sleep <bat|ac|any>    sleep; with "hibernate after" set (Settings) = sleep, then hibernate later
#   udiksa idle lid                   lid closed (Hyprland switch bind): lock now, unless the lid action is "ignore"
#                                     (logind skips the lid for 30 s after waking, so the lock can't wait for sleep)
# A timer for battery and one for the charger both run; the one for the other power source does nothing.
set -u
on_ac=0
for s in /sys/class/power_supply/*; do
    [[ $(cat "$s/type" 2>/dev/null) == Mains && $(cat "$s/online" 2>/dev/null) == 1 ]] && on_ac=1
done
case ${2:-any} in
    bat) ((on_ac)) && exit 0 ;;
    ac)  ((on_ac)) || exit 0 ;;
esac
case ${1:-} in
    off)   hyprctl dispatch 'hl.dsp.dpms({action = "off"})' >/dev/null ;;
    sleep) if [[ -f /etc/systemd/sleep.conf.d/udiksa.conf ]]; then systemctl suspend-then-hibernate; else systemctl suspend; fi ;;
    lid)   key=HandleLidSwitch
           # docked = logind's own test (another screen connected, even while the laptop screen is switched off)
           [[ $(busctl get-property org.freedesktop.login1 /org/freedesktop/login1 org.freedesktop.login1.Manager Docked) == 'b true' ]] \
               && key=HandleLidSwitchDocked || { ((on_ac)) && key=HandleLidSwitchExternalPower; }
           [[ $(busctl get-property org.freedesktop.login1 /org/freedesktop/login1 org.freedesktop.login1.Manager $key) == *'"ignore"' ]] || loginctl lock-session ;;
    *)     sed -n '2,8p' "$0"; exit 2 ;;
esac
