#!/usr/bin/env python3
"""udiksa font -- ONE system font, changed everywhere at once, live, like a theme (Settings > Themes > Font).

  udiksa font                  the font in use (JSON) + every installed font
  udiksa font list             installed fonts, one per line:  <name> <TAB> sans|mono
  udiksa font <name>           use this font everywhere, e.g. udiksa font "Space Grotesk"
  udiksa font reset            back to Space Grotesk
  udiksa font apply            write everything again (also done by every theme change)

The font is used by the shell (notch, Settings, lock), GTK / Qt apps, browsers' default fonts, viewers and the login screen.
Terminals and code need letters that line up in columns: if the font is monospace it is used there too; if not, the terminal /
Zed / "monospace" use its companion (Space Grotesk -> Space Mono, Geist -> Geist Mono, ...), else JetBrains Mono. The fonts are
found by themselves: install any font (pacman, AUR, ~/.local/share/fonts) and it shows up. The choice is kept in
~/.local/state/rice/fonts.json. The boot menu (GRUB) keeps its own font."""
import json, os, re, subprocess, sys

HOME = os.path.expanduser("~")
FONTS = os.path.join(HOME, ".local/state/rice/fonts.json")
DEFAULT = "Space Grotesk"
THEME = os.path.join(HOME, ".local/lib/udiksa/theme")
# companions for terminals: a proportional font -> the monospace sibling that matches it (first installed wins)
PAIRS = {"space grotesk": "SpaceMono", "space mono": "SpaceMono", "geist": "GeistMono", "ibm plex sans": "BlexMono",
         "source sans": "SauceCodePro", "fira sans": "FiraCode", "ubuntu": "UbuntuMono", "roboto": "RobotoMono",
         "cascadia": "CaskaydiaCove", "hanken grotesk": "JetBrainsMono", "commit mono": "CommitMono"}
FALLBACK_MONO = ["JetBrainsMono Nerd Font", "Iosevka Nerd Font", "DejaVu Sans Mono"]
NOTO_KEEP = {"Noto Sans", "Noto Serif", "Noto Sans Mono", "Noto Sans Display", "Noto Serif Display"}
VARIANT_WORDS = {"Arabic", "Devanagari", "Hebrew", "JP", "KR", "TC", "SC", "Thai", "Looped", "Condensed", "SemiCondensed", "ExtraCondensed",
                 "Compressed", "Heavy", "Caption", "SmText", "Subhead", "Pro", "Unicase", "Upright", "Infant", "Variable", "Mono", "Propo", "Display", "Text", "Math", "TeX", "Gyre"}


def installed():
    """{family: is_mono} of the usable fonts: TrueType / OpenType only, no script-specific Noto, no width / script / Nerd
    "Mono" or "Propo" twins of a family that is listed anyway (Iosevka Nerd Font Mono -> Iosevka Nerd Font)"""
    out = subprocess.run(["fc-list", "-f", "%{family[0]}\t%{spacing}\t%{fontformat}\n"], capture_output=True, text=True).stdout
    fams = {}
    for line in out.splitlines():
        name, spacing, fmt = (line.split("\t") + ["", ""])[:3]
        if not name or fmt not in ("TrueType", "CFF"):
            continue
        fams[name] = fams.get(name, False) or spacing in ("100", "110")
    keep = {}
    for n, mono in fams.items():
        if n.startswith("Symbols") or "Emoji" in n or n == "mtx":
            continue
        if n.startswith("Noto ") and n not in NOTO_KEEP:
            continue
        parts = n.split(" ")
        # a longer name whose extra words are only variants of a shorter listed family (IBM Plex Sans Arabic, Cormorant SC, ...)
        def twin(i):
            base, extra = " ".join(parts[:i]), set(parts[i:])
            return base in fams and extra <= VARIANT_WORDS and (not extra & {"Mono", "Propo"} or base.endswith("Nerd Font"))
        if any(twin(i) for i in range(1, len(parts))):
            continue
        keep[n] = mono or (n.endswith("Nerd Font") and fams.get(n + " Mono", False))     # Nerd Fonts: the plain name is monospace when its "Mono" twin is
    return dict(sorted(keep.items(), key=lambda kv: kv[0].lower()))


def companion(font, fams):
    """the monospace family the terminal uses for this system font"""
    if fams.get(font):
        return font
    key = next((k for k in PAIRS if font.lower().startswith(k)), None)
    if key:
        hit = next((n for n in fams if fams[n] and n.startswith(PAIRS[key]) and n.endswith("Nerd Font")), None)
        if hit:
            return hit
    return next((m for m in FALLBACK_MONO if fams.get(m)), next((n for n, m in fams.items() if m), font))


def current():
    try:
        d = json.load(open(FONTS))
        return d.get("font") or d.get("ui") or DEFAULT          # the older two-font file: its interface font
    except (OSError, ValueError):
        return DEFAULT


def save(font, fams):
    os.makedirs(os.path.dirname(FONTS), exist_ok=True)
    with open(FONTS, "w") as f:
        json.dump({"font": font, "ui": font, "mono": companion(font, fams)}, f, indent=2); f.write("\n")


def apply():
    subprocess.run([THEME, "fonts"])


def main(a):
    fams = installed()
    if not a:
        font = current()
        print(json.dumps({"font": font, "mono": companion(font, fams), "installed": [[n, m] for n, m in fams.items()]}))
    elif a[0] == "list":
        for n, m in fams.items():
            print(f"{n}\t{'mono' if m else 'sans'}")
    elif a[0] == "reset":
        save(DEFAULT, fams); apply(); print(f"font: {DEFAULT} (terminal: {companion(DEFAULT, fams)})")
    elif a[0] == "apply":
        save(current(), fams); apply()
    elif a[0] in ("-h", "--help", "help"):
        print(__doc__)
    else:
        name = " ".join(a)
        match = next((n for n in fams if n.lower() == name.lower()), None)
        if not match:
            sys.exit(f"font '{name}' is not installed (udiksa font list)")
        save(match, fams); apply()
        print(f"font: {match} (terminal: {companion(match, fams)})")


if __name__ == "__main__":
    main(sys.argv[1:])
