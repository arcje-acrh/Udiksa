#!/usr/bin/env bash
# rice-xdpi -- load ~/.Xresources and set Xft.dpi = 96 x the screen scale, so X11 apps (drawn unscaled by Hyprland,
# misc.lua xwayland.force_zero_scaling) size themselves right on ANY screen. Run at login (autostart.lua) and after
# a scale change in Settings > Display. Uses the focused screen (or the first one).
xrdb -merge "$HOME/.Xresources" 2>/dev/null
scale=$(hyprctl monitors -j 2>/dev/null | jq -r '(map(select(.focused)) + .)[0].scale // 1')
dpi=$(awk -v s="$scale" 'BEGIN { printf "%d", 96 * s + 0.5 }')
echo "Xft.dpi: $dpi" | xrdb -merge
