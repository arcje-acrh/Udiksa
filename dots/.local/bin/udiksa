#!/usr/bin/env bash
# udiksa -- the one command for the whole Udiksa rice: `udiksa <command> [args]`, `udiksa help`, `udiksa <command> -h`.
# The commands themselves are small scripts in ~/.local/lib/udiksa/ (hardware / optional parts add theirs there:
# `udiksa kbd`, `udiksa slash`, `udiksa onlyoffice`); this file only finds them, plus the built-ins below.
set -u
LIB="${UDIKSA_LIB:-$HOME/.local/lib/udiksa}"
REPO="$(cd "$(dirname "$(readlink -f "$0")")/../../.." 2>/dev/null && pwd)"      # the Udiksa repo (dots/ links point into it)
PANELS="battery power volume wifi bluetooth media notifications system tailscale launcher usage clock clockTimer clockAlarm clockReminder clockEvent"

die() { echo "udiksa: $*" >&2; exit 1; }
ipc() { qs ipc call "$@"; }

# header comment of a script (the lines under the shebang, or its docstring) = its --help
script_help() {
    awk 'NR==1 { next }
         NR==2 && /^"""/ { doc = 1; sub(/^"""/, ""); print; if ($0 ~ /"""$/) exit; next }
         doc { if ($0 ~ /"""/) { sub(/""".*/, ""); if ($0 != "") print; exit } print; next }
         /^#/ { sub(/^# ?/, ""); print; next }
         { exit }' "$1"
}

help() {
    local B="" C="" D="" R=""                      # bold / command colour / dim / reset: only on a terminal (and not with NO_COLOR)
    [[ -t 1 && -z ${NO_COLOR:-} ]] && { B=$'\e[1m'; C=$'\e[36m'; D=$'\e[2m'; R=$'\e[0m'; }
    sec() { printf '\n%s%s%s\n' "$B" "$1" "$R"; }
    row() { printf '  %s%-11s%s %s\n' "$C" "$1" "$R" "$2"; }
    ex()  { printf '  %s$%s %-32s %s%s%s\n' "$D" "$R" "$1" "$D" "$2" "$R"; }
    echo "One command for the whole Udiksa rice."
    sec "USAGE";    echo "  udiksa <command> [arguments]"
    sec "LOOK"
    row theme     "Themes: next, set <name>, random, names, apply, import"
    row wallpaper "Wallpaper: next, prev, random, set <picture>"
    row cursor    "The theme-coloured mouse pointers"
    row font      "Interface and monospace fonts, changed everywhere"
    sec "CAPTURE"
    row shot      "Screenshot: area, window, screen, edit"
    row record    "Screen recording: screen, region, sound, stop"
    row pick      "Pick a colour from the screen"
    sec "SHELL"
    row toggle    "Show or hide a notch panel, Settings or the theme switcher"
    row open      "Open a notch panel (close: udiksa close)"
    row clipboard "Clipboard history in the launcher"
    row emoji     "Emoji picker in the launcher"
    row lock      "Lock the screen"
    row dnd       "Do not disturb on or off"
    row osd       "Show a message in the notch"
    row scratch   "App scratchpads: sysmon, music, chat"
    row settings  "Settings back end: get, set, reset, power, monitor, bind"
    row shell     "Start or restart the shell (--restart)"
    row ipc       "Any shell command: ipc <target> <function>, ipc show"
    sec "SYSTEM"
    row display   "Screens: extend, mirror, external, laptop"
    row touchpad  "Touchpad on or off"
    row panel-hz  "Refresh rate of the laptop panel"
    row gpu       "GPU mode and power: mode, display, dgpu, all"
    row idle      "Timed actions of hypridle: off, sleep"
    row defaults  "Default apps per file type"
    row flash     "Write a disk image to a USB stick"
    row comfort   "Comfort lighting: warm screen colours (eye shield)"
    row xdpi      "DPI for X11 apps"
    row clock     "The terminal clock window"
    [[ -x $LIB/kbd ]] && { sec "HARDWARE"; row kbd "ASUS keyboard lighting"; row slash "ASUS lid light"; }
    sec "MANAGE"
    row status    "Version and a quick look at this install (also: just `udiksa`)"
    row install   "Run installer parts: arch, apps, rice"
    row update    "Update the system, or: update dots (pull + relink)"
    row doctor    "Check that everything the rice needs is in place"
    row firstrun  "Setup steps that need a running desktop"
    row completion "Print the bash completion script"
    row version   "Version of this install"
    sec "EXAMPLES"
    ex 'udiksa theme set "Tokyo Night"'   "switch theme"
    ex "udiksa shot area"                 "screenshot a region"
    ex "udiksa toggle system"             "open the system panel"
    ex "udiksa wallpaper random"          "a new wallpaper in this theme"
    sec "LEARN MORE"
    echo "  udiksa <command> -h    usage of one command (--full: everything it documents)"
    echo "  <Tab>                  completes commands, panels and theme names"
}

# bare `udiksa`: version + a quick look at the state of this install, then the commands by group
status() {
    local B="" C="" D="" R="" v
    [[ -t 1 && -z ${NO_COLOR:-} ]] && { B=$'\e[1m'; C=$'\e[36m'; D=$'\e[2m'; R=$'\e[0m'; }
    line() { printf '  %s%-9s%s %s\n' "$D" "$1" "$R" "$2"; }
    printf '%sudiksa%s %s  %s-  one command for the whole rice%s\n\n' "$B" "$R" "$(git -C "$REPO" describe --always --dirty 2>/dev/null || echo unknown)" "$D" "$R"
    printf '%sSTATUS%s\n' "$B" "$R"
    v=$(hyprctl version -j 2>/dev/null | jq -r .tag 2>/dev/null)
    line Hyprland "${v:-not running}$(pgrep -x quickshell >/dev/null && echo '  ·  shell running' || echo '  ·  shell NOT running (udiksa shell)')"
    v=$("$LIB/theme" current 2>/dev/null | jq -r 'if .theme then "\(.theme)  ·  \(.wallpaper | split("/") | last)" else empty end' 2>/dev/null)
    line Theme "${v:-none applied yet (udiksa theme set <name>)}"
    v=$(hyprctl monitors -j 2>/dev/null | jq -r '(map(select(.focused)) + .)[0] | "\(.name)  \(.width)x\(.height) @ \(.refreshRate | round) Hz  ·  scale \(.scale)"' 2>/dev/null)
    [[ -n $v && $v != null ]] && line Screen "$v"
    if command -v supergfxctl >/dev/null; then
        v=$("$LIB/gpu" all 2>/dev/null | awk -F': *' '/^mode/ {m=$2} /^dGPU/ {d=$2} END {if (m) print m "  ·  dGPU " d}')
        [[ -n $v ]] && line GPU "$v"
    fi
    for v in /sys/class/power_supply/BAT*; do
        [[ -r $v/capacity ]] && { line Battery "$(cat "$v/capacity")%  ·  $(tr 'A-Z' 'a-z' < "$v/status")"; break; }
    done
    local m=()
    [[ -e ${XDG_RUNTIME_DIR:-/tmp}/udiksa-record ]] && m+=("recording")
    [[ -e ${XDG_RUNTIME_DIR:-/tmp}/udiksa-awake ]] && m+=("keep awake")
    [[ -e ${XDG_RUNTIME_DIR:-/tmp}/udiksa-gamemode ]] && m+=("game mode")
    local mm=""; for v in "${m[@]}"; do mm+="${mm:+, }$v"; done
    line Modes "${mm:-none}"
    printf '\n%sCOMMANDS%s\n' "$B" "$R"
    grp() { printf '  %s%-9s%s %s\n' "$D" "$1" "$R" "$2"; }
    grp look     "theme wallpaper font cursor"
    grp capture  "shot record pick"
    grp shell    "toggle open clipboard emoji lock dnd osd scratch settings shell ipc"
    grp system   "display comfort touchpad panel-hz gpu idle defaults flash xdpi clock"
    [[ -x $LIB/kbd ]] && grp hardware "kbd slash"
    grp manage   "install update doctor firstrun completion version"
    printf '\n  %sudiksa help%s            every command with a description\n' "$C" "$R"
    printf '  %sudiksa <command> -h%s    usage of one command\n' "$C" "$R"
    printf '  %sudiksa doctor%s          check that everything is in place\n' "$C" "$R"
}

# `udiksa <command> -h`: the curated text from lib/udiksa/_help in one layout (title, USAGE, tables, NOTES, EXAMPLES)
cmd_help() {
    local name=$1 B="" C="" D="" R="" full=""
    [[ -t 1 && -z ${NO_COLOR:-} ]] && { B=$'\e[1m'; C=$'\e[36m'; D=$'\e[2m'; R=$'\e[0m'; }
    [[ -x $LIB/$name ]] && full=1
    awk -v name="$name" -v B="$B" -v C="$C" -v D="$D" -v R="$R" -v full="$full" '
        function wrap(txt, ind,    w, n, i, line, a) {
            n = split(txt, a, " "); line = ind
            for (i = 1; i <= n; i++) {
                if (length(line) + length(a[i]) + 1 > 78 && line != ind) { print line; line = ind }
                line = (line == ind ? line a[i] : line " " a[i])
            }
            print line
        }
        $0 == "[" name "]" { inb = 1; next }
        inb && /^\[/ { exit }
        inb { L[++n] = $0 }
        END {
            if (!n) exit 3
            printf "%sudiksa %s%s  \342\200\224  %s\n", B, name, R, L[1]
            first = 1
            for (i = 2; i <= n; i++) if (L[i] ~ /^usage:/) {
                a = L[i]; sub(/^usage: */, "", a); if (a ~ /^\(no arguments\)/) a = ""
                if (first) { printf "\n%sUSAGE%s\n", B, R; first = 0 }
                print "  udiksa " name (a == "" ? "" : " " a)
            }
            w = 0
            for (i = 2; i <= n; i++) if (L[i] ~ /^  [^ ]/) {
                s = substr(L[i], 3)
                if (match(s, /  +/)) { l = RSTART - 1; if (l > w && l <= 36) w = l }
            }
            for (i = 2; i <= n; i++) {
                if (L[i] ~ /^#/) { h = L[i]; sub(/^# */, "", h); printf "\n%s%s%s\n", B, h, R }
                else if (L[i] ~ /^  [^ ]/) {
                    s = substr(L[i], 3)
                    if (match(s, /  +/)) printf "  %s%-*s%s  %s\n", C, w, substr(s, 1, RSTART - 1), R, substr(s, RSTART + RLENGTH)
                    else print "  " s
                }
            }
            first = 1
            for (i = 2; i <= n; i++) if (L[i] ~ /^note:/) {
                t = L[i]; sub(/^note: */, "", t)
                if (first) { printf "\n%sNOTES%s\n", B, R; first = 0 }
                wrap(t, "  ")
            }
            first = 1
            for (i = 2; i <= n; i++) if (L[i] ~ /^example:/) {
                t = L[i]; sub(/^example: */, "", t)
                if (first) { printf "\n%sEXAMPLES%s\n", B, R; first = 0 }
                if (match(t, /  +/)) printf "  %s$%s %-40s %s%s%s\n", D, R, substr(t, 1, RSTART - 1), D, substr(t, RSTART + RLENGTH), R
                else print "  $ " t
            }
            if (full) printf "\n%sudiksa %s --full%s  everything the script documents\n", D, name, R
        }' "$LIB/_help"
}

doctor() {
    local bad=0 c
    ok()  { printf '  \033[32mok\033[0m   %s\n' "$*"; }
    no()  { printf '  \033[31mMISSING\033[0m %s\n' "$*"; bad=1; }
    warn(){ printf '  \033[33mnote\033[0m  %s\n' "$*"; }
    echo "Commands the rice uses"
    for c in hyprctl qs awww grim slurp hyprshot satty gpu-screen-recorder hyprpicker wl-copy cliphist playerctl jq stow kitty notify-send brightnessctl; do
        command -v "$c" >/dev/null && ok "$c" || no "$c (see setup/packages/*.txt)"
    done
    echo "Hyprland + shell"
    local hv; hv=$(hyprctl version -j 2>/dev/null | jq -r .tag 2>/dev/null)
    [[ -n $hv ]] && ok "Hyprland $hv" || no "Hyprland is not running (or hyprctl cannot reach it)"
    pgrep -x quickshell >/dev/null && ok "Quickshell shell running" || no "the shell is not running: udiksa shell"
    [[ -s $HOME/.config/quickshell/colors.json ]] && ok "theme colours written (colors.json)" || no "no colors.json: udiksa theme reapply"
    echo "udiksa itself"
    for c in theme shot record pick scratch settings shell idle cursor display touchpad gpu; do
        [[ -x $LIB/$c ]] && ok "udiksa $c" || no "udiksa $c ($LIB/$c)"
    done
    [[ -x $LIB/kbd ]] && ok "udiksa kbd (ASUS)" || warn "udiksa kbd / slash not installed (only ASUS laptops need them)"
    local dead; dead=$(find "$HOME/.config" "$HOME/.local/bin" "$HOME/.local/lib/udiksa" "$HOME/.local/share/applications" -xtype l -lname '*/Udiksa/*' 2>/dev/null | head -5)
    [[ -z $dead ]] && ok "no dangling links in ~" || { no "dangling links (run: $REPO/setup/rice.sh home):"; echo "$dead" | sed 's/^/         /'; }
    command -v supergfxctl >/dev/null && { systemctl is-active --quiet supergfxd && ok "supergfxd (GPU switching)" || warn "supergfxd is installed but not running"; }
    echo
    (( bad )) && { echo "Some things need attention (above)."; return 1; } || echo "All good."
}

update() {
    case ${1:-system} in
        system) exec "$HOME/.local/share/rice/scripts/update-system.sh" ;;
        dots)
            [[ -d $REPO/.git ]] || die "no git checkout of Udiksa found at $REPO"
            git -C "$REPO" pull --ff-only || die "pull failed (local changes or a diverged branch): fix in $REPO"
            "$REPO/setup/rice.sh" home && ipc themes close >/dev/null 2>&1; hyprctl reload >/dev/null 2>&1; "$LIB/theme" reapply
            ;;
        *) die "update [system|dots]" ;;
    esac
}

cmd=${1:-status}; [[ $# -gt 0 ]] && shift
if [[ $cmd != help && $cmd != -h && $cmd != --help ]]; then
    case ${1:-} in
        -h|--help) cmd_help "$cmd" || { [[ -x $LIB/$cmd ]] && script_help "$LIB/$cmd" || die "unknown command '$cmd' (udiksa help)"; }; exit 0 ;;
        --full) [[ -x $LIB/$cmd ]] && { script_help "$LIB/$cmd"; exit 0; } ;;
    esac
fi
case $cmd in
    status) status ;;
    help|-h|--help) if [[ -n ${1:-} ]]; then cmd_help "$1" || die "no help for '$1' (udiksa help)"; else help; fi ;;
    version|--version|-V) echo "udiksa $(git -C "$REPO" describe --always --dirty 2>/dev/null || echo unknown)" ;;
    completion) cat "$HOME/.local/share/bash-completion/completions/udiksa" ;;
    doctor) doctor ;;
    install) [[ -x $REPO/install.sh ]] || die "install.sh not found in $REPO"; exec "$REPO/install.sh" "$@" ;;
    update) update "$@" ;;
    toggle)
        [[ -n ${1:-} ]] || { echo "udiksa toggle <panel>   panels: $PANELS | themes | settings"; exit 1; }
        case $1 in themes|settings) ipc "$1" toggle ;; *) ipc notch toggle "$1" ;; esac ;;
    open)  [[ -n ${1:-} ]] || die "open <panel>   panels: $PANELS"; ipc notch open "$1" ;;
    close) ipc notch close ;;
    clipboard) ipc notch open launcher:clip ;;
    emoji)     ipc notch open launcher:emoji ;;
    lock) ipc lock lock ;;
    dnd)  ipc notifications dnd ;;
    osd)  [[ $# -ge 2 ]] || die 'osd "<icon>" "<text>"'; ipc osd say "$1" "$2" ;;
    ipc)  if [[ ${1:-} == show ]]; then qs ipc show; else [[ ${1:-} == call ]] && shift; [[ $# -ge 2 ]] || die "ipc <target> <function> [args]   (udiksa ipc show lists them)"; ipc "$@"; fi ;;
    wallpaper)
        case ${1:-} in
            next|prev) exec "$LIB/theme" "$1" ;;
            random) exec "$LIB/theme" random wallpaper ;;
            set) [[ -f ${2:-} ]] || die "wallpaper set <picture>"; exec "$LIB/theme" apply "$2" ;;
            current|"") "$LIB/theme" current | jq -r .wallpaper ;;
            *) die "wallpaper [next|prev|random|set <picture>|current]" ;;
        esac ;;
    *)
        [[ -x $LIB/$cmd && $cmd != *[/.]* ]] || die "unknown command '$cmd' (udiksa help)"
        exec "$LIB/$cmd" "$@" ;;
esac
