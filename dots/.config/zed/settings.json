// Zed settings. The "Rice" theme is written by rice-theme on every theme change (~/.config/zed/themes/rice.json).
{
  "agent": {
    "threads_sidebar": {
      "position": "right"
    },
    "favorite_models": [],
    "model_parameters": []
  },
  "project_panel": {
    "dock": "left"
  },
  "icon_theme": {
    "mode": "dark",
    "light": "Zed (Default)",
    "dark": "Zed (Default)"
  },
  "session": {
    "trust_all_worktrees": true
  },
  "agent_servers": {
    "claude-acp": {
      "type": "registry"
    }
  },
  "base_keymap": "JetBrains",
  "theme": {
    "mode": "system",
    "light": "Gruvbox Dark",
    "dark": "Gruvbox Dark"
  },
  "ui_font_family": "Iosevka Nerd Font",
  "buffer_font_family": "Iosevka Nerd Font",
  "buffer_font_size": 15,
  "ui_font_size": 15,
  "telemetry": { "diagnostics": false, "metrics": false },
  "auto_update": false,
  "vim_mode": false
}
