{
    // fastfetch config -- layout adapted from JaKooLit/Hyprland-Dots (the popular
    // grouped-tree style: coloured section headers, nerd-font icon per line).
    // Needs a Nerd Font in the terminal (Iosevka Nerd Font Mono, already set).
    //
    // COLOURS: this is the TEMPLATE. ~/.local/bin/udiksa theme writes config.jsonc from it on every theme
    // change, swapping the colour names for the theme's own colours (matching the logo's gradient):
    //     "yellow" = accent2 (logo top)   "cyan" = accent (logo bottom)   "bright_black" = muted
    // Edit this file, not config.jsonc (generated, not in the repo).

    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

    // LOGO: the Arch logo as text (logo.txt: sextant blocks, 32x16 cells = square, as tall as the text block),
    // made once from logo.svg. Its colours are kitty's slots 23-30 (udiksa theme writes them: accent2 -> accent), not
    // hex, so a fastfetch already on screen recolours live on a theme switch. padding top 1 = one row down (user's pick).
    "logo": {
        "type": "file",
        "source": "~/.config/fastfetch/logo.txt",
        "color": { "1": "38;5;23", "2": "38;5;24", "3": "38;5;25", "4": "38;5;26",
                   "5": "38;5;27", "6": "38;5;28", "7": "38;5;29", "8": "38;5;30" },
        "padding": { "top": 1, "left": 1, "right": 2 }
    },

    "display": {
        "color": { "separator": "bright_black", "title": "cyan" },
        // usage percentages (memory, disk, ...): low / mid / high = accent / accent2 / the theme's danger colour,
        // as kitty slots 16 / 17 / 21 (udiksa theme writes them), so they follow a theme switch live too
        "percent": { "color": { "green": "38;5;16", "yellow": "38;5;17", "red": "38;5;21" } },
        // fixed key column so every value lines up (headers and tree keys differ in length)
        "key": { "width": 10 },
        "separator": " 󰑃  "
    },

    "modules": [
        "break",
        "title",
        "break",

        // ---- DISTRO (amber) ----
        { "type": "os", "key": " DISTRO", "keyColor": "yellow" },
        { "type": "kernel", "key": "│ ├", "keyColor": "yellow" },
        { "type": "uptime", "key": "│ ├󰅐", "keyColor": "yellow" },
        { "type": "packages", "key": "│ ├󰏖", "keyColor": "yellow" },
        { "type": "shell", "key": "│ └", "keyColor": "yellow" },

        // ---- DE/WM (coral) ----
        { "type": "wm", "key": " DE/WM", "keyColor": "cyan" },
        { "type": "display", "key": "│ ├󰍹", "keyColor": "cyan", "compactType": "original-with-refresh-rate" },
        { "type": "terminal", "key": "│ └", "keyColor": "cyan" },

        // ---- SYSTEM (amber) ----
        { "type": "host", "key": "󰌢 SYSTEM", "keyColor": "yellow" },
        { "type": "cpu", "key": "│ ├󰻠", "keyColor": "yellow" },
        { "type": "gpu", "key": "│ ├󰻑", "keyColor": "yellow" },
        // one line of GPU state from ~/.local/bin/udiksa gpu (never wakes the dGPU)
        { "type": "command", "key": "│ ├󰘚", "keyColor": "yellow",
          "text": "g=$HOME/.local/bin/udiksa gpu; echo \"$($g mode) · screen on $($g display) · dGPU $($g dgpu)\"" },
        { "type": "memory", "key": "│ ├󰾆", "keyColor": "yellow" },
        { "type": "disk", "key": "│ └󰋊", "keyColor": "yellow" }
    ]
}
