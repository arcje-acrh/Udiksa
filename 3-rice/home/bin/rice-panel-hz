#!/usr/bin/env bash
# rice-panel-hz <hz> -- set the refresh rate of the laptop's own panel (eDP / LVDS / DSI), keeping its current
# resolution, position and scale. Used by the notch / Settings (Power.qml: 60 Hz on battery, high on the charger).
# No built-in panel, or that rate not offered by it: does nothing.
hz=${1:?usage: rice-panel-hz <hz>}
hyprctl monitors -j | jq -r --argjson hz "$hz" '
  .[] | select(.name | test("^(eDP|LVDS|DSI)")) | . as $m |
  select(any($m.availableModes[]; startswith("\($m.width)x\($m.height)@\($hz)"))) |
  "hl.monitor({ output = \"\(.name)\", mode = \"\(.width)x\(.height)@\($hz)\", position = \"\(.x)x\(.y)\", scale = \(.scale) })"' |
  head -1 | while read -r lua; do hyprctl eval "$lua" >/dev/null; done
