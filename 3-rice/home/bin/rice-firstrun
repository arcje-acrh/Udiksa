#!/usr/bin/env bash
# rice-firstrun -- the setup steps that need a running desktop session (Hyprland + D-Bus). Started once by
# autostart.lua when ~/.local/state/rice/firstrun exists (3-rice/apply.sh creates it), then removes that file.
# Can also be run by hand at any time.
set -uo pipefail
log="$HOME/.cache/rice-firstrun.log"; exec >>"$log" 2>&1; echo "== $(date)"
sleep 3                                              # let awww-daemon and Quickshell start

gsettings set org.gnome.desktop.interface monospace-font-name 'Iosevka Nerd Font Mono 11'
gsettings set org.gnome.desktop.wm.preferences button-layout 'appmenu:'   # no close / minimise buttons in GTK title bars

# a theme: the one saved before, else Everforest Dark, else the first there is
theme_img=$(python3 -c 'import json,os;print(json.load(open(os.path.expanduser("~/.local/state/rice/theme.json")))["wallpaper"])' 2>/dev/null)
[[ -f ${theme_img:-} ]] || theme_img=$(find "$HOME/Pictures/Wallpapers/Everforest Dark" -maxdepth 1 -iregex '.*\.\(jpe?g\|png\|webp\)' 2>/dev/null | sort | head -1)
[[ -f ${theme_img:-} ]] || theme_img=$(find "$HOME/Pictures/Wallpapers" -mindepth 2 -iregex '.*\.\(jpe?g\|png\|webp\)' | sort | head -1)
[[ -f ${theme_img:-} ]] && "$HOME/.local/bin/rice-theme" apply "$theme_img" --transition none

"$HOME/.local/bin/rice-defaults"
# Settings > Power (~/.config/hypr/power.json): idle timers (hypridle.conf) + lid / power button / hibernate delay (logind)
"$HOME/.local/bin/rice-settings" power apply
rm -f "$HOME/.local/state/rice/firstrun"
notify-send -a Rice "Setup finished" "Theme, default apps and desktop settings are in place. Super+T changes the theme." 2>/dev/null
echo "done"
