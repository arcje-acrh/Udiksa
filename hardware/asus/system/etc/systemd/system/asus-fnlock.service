[Unit]
Description=Set ASUS keyboard Fn-lock off (hid_asus forces it on at boot and after every sleep)
# runs at boot, and again after every kind of sleep: suspend, hibernate, and the mixed ones
After=suspend.target hibernate.target hybrid-sleep.target suspend-then-hibernate.target

[Service]
Type=oneshot
# small delay so hid_asus's own post-bind/resume Fn-lock sync runs first
ExecStartPre=/usr/bin/sleep 2
ExecStart=/usr/local/bin/asus-fnlock-off 0

[Install]
WantedBy=multi-user.target suspend.target hibernate.target hybrid-sleep.target suspend-then-hibernate.target
