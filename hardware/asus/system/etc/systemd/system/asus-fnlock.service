[Unit]
Description=Set ASUS keyboard Fn-lock off (hid_asus forces it on at bind and resume)
After=suspend.target

[Service]
Type=oneshot
# small delay so hid_asus's own post-bind/resume Fn-lock sync runs first
ExecStartPre=/usr/bin/sleep 2
ExecStart=/usr/local/bin/asus-fnlock-off 0

[Install]
WantedBy=multi-user.target suspend.target
